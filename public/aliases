function printBranches
  for k in (git branch | string replace -r '^..' '')
    set -l meta (git log -1 --pretty=format:'%Cgreen%ci %Cred%cr%Creset' $k --)
    echo -e "$meta\t$k"
  end | sort
end

# pushes the current branch to the same named remote
function pushRemoteBranch
  set -l currentBranch (git symbolic-ref HEAD 2>/dev/null | string replace -r '^refs/heads/' '')
  git push -u origin $currentBranch
end

function setUpstreamBranch
  set -l currentBranch (git symbolic-ref HEAD 2>/dev/null | string replace -r '^refs/heads/' '')
  git branch --set-upstream-to=origin/$currentBranch $currentBranch
end

function pullRemoteBranch
  set -l currentBranch (git symbolic-ref HEAD 2>/dev/null | string replace -r '^refs/heads/' '')
  git pull origin $currentBranch
end

function diffRemoteBranch
  set -l currentBranch (git symbolic-ref HEAD 2>/dev/null | string replace -r '^refs/heads/' '')
  git diff --full-index origin/$currentBranch
end


