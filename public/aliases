# vscode wireup
function code
    if test (count $argv) -eq 0
        open -a "Visual Studio Code"
    else
        set -l argPath $argv[1]
        if string match -q '/*' $argPath
            open -a "Visual Studio Code" "$argPath"
        else
            open -a "Visual Studio Code" "$PWD/$argPath"
        end
    end
end

