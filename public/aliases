function set_default_branch
  # Bail if not in a git repo
  git rev-parse --git-dir >/dev/null 2>&1
  or return 1

  if git show-ref --verify --quiet refs/heads/main; or git show-ref --verify --quiet refs/remotes/origin/main
    set -gx DEFAULT_BRANCH main
  else
    set -gx DEFAULT_BRANCH master
  end
end

