# requires "brew install fzf"
alias fbr="fuzzy_branch_search"
function fuzzy_branch_search
  set -l branch (git branch -a | fzf +s +m -e)
  set -l branchName (echo $branch | string replace -r '.* remotes/origin/' '' | string replace -r '.* ' '')
  git checkout $branchName
end

